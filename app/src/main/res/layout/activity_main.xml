<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity shell: screens, bottom scrim, mini-player, floating nav, full-player layer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mpBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/nav_bottom_scrim" />

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical" />

    <!-- Full player (T4) is added here over everything. -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
